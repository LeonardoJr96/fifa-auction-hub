# URL base da API Django (sem barra no final)
VITE_API_URL=http://localhost:8000/api/v1

# (opcional) URL base do WebSocket do Django Channels.
# Se omitido, é derivado de VITE_API_URL -> ws://localhost:8000/ws
# O canal do leilão é ${VITE_WS_URL}/auctions/{auction_id}/
VITE_WS_URL=ws://localhost:8000/ws
