# Copie para .env na raiz do monorepo (único arquivo de config).
# Backend (django-environ) e Vite (envDir apontando para a raiz) leem daqui.

# Django
SECRET_KEY=troque-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=core.settings.development

# Banco (local sem Docker — SQLite automático se DATABASE_URL omitido)
# DATABASE_URL=postgres://fifa:fifa@localhost:5432/fifa_auction_hub

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# CORS / CSRF (dev: porta do Vite; Docker: porta do nginx)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=False

# Frontend (opcional — omitido = mesma origem + proxy Vite em dev / nginx em Docker)
# VITE_API_URL=/api/v1
# VITE_WS_URL=

# Docker Compose
POSTGRES_DB=fifa_auction_hub
POSTGRES_USER=fifa
POSTGRES_PASSWORD=fifa
NGINX_PORT=8080
SEED_ON_START=true

# Integrações
SCRAPER_IMPORT_KEY=troque-por-um-valor-secreto-de-verdade
PIX_GATEWAY=payment.gateways.fake.FakePixGateway

## Media (WebP)
# Novos uploads viram WebP automaticamente (signals).
# Para limpar duplicatas PNG existentes:
#   cd backend && python manage.py optimize_media
